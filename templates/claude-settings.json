{
  "enabledMcpjsonServers": [
    "jasp"
  ],
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "100000"
  },
  "permissions": {
    "allow": [
      "mcp__jasp__jasp_ping",
      "mcp__jasp__jasp_rpc_discover",
      "mcp__jasp__jasp_modules_list",
      "mcp__jasp__jasp_analyses_list",
      "mcp__jasp__jasp_get_analyses_state",
      "mcp__jasp__jasp_analysis_results",
      "mcp__jasp__jasp_analysis_context",
      "mcp__jasp__jasp_data_info",
      "mcp__jasp__jasp_data_load_status",
      "Read(~/.var/app/org.jaspstats.JASP/data/JASP/JASP/temp/**)",
      "Read(~/.local/share/JASP/JASP/temp/**)"
    ]
  }
}
